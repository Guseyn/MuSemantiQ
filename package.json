{
  "name": "MuSemantiQ",
  "version": "1.0.0",
  "description": "MuSemantiQ",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-symlinks.js",
    "setup:symlinks": "node scripts/setup-symlinks.js",
    "msq:apps:update": "node scripts/copy-msq-into-apps.js",
    "create:msq:worker": "node scripts/create-msq-worker.js",
    "web-components:update": "node scripts/copy-web-components.js",
    "watch:src": "node scripts/watch-msq-src.js",
    "watch:web-components": "node scripts/watch-web-components.js",

    "test:visual:all": "node scripts/visual-tests.js",
    "test:audio:all": "node scripts/audio-tests.js",
    "test:serializer:all": "node scripts/serializer-tests.js",
    "test:all": "npm run test:visual:all && npm run test:audio:all && npm run test:serializer:all",
    "coverage": "c8 npm run test:all",
    "coverage:report": "c8 report --reporter=html",
    "coverage:check": "c8 check-coverage --statements 87 --branches 86 --functions 82 --lines 87",

    "ehtml:update": "rsync -a --delete ../EHTML/src/ browser-app/web-app/static/js/ehtml",
    "nodes:update": "rsync -a --delete ../nodes.js/nodes/ browser-app/nodes/",
    "eui:update": "rsync -a --delete ../e-ui/static/js/e-ui/ browser-app/web-app/static/js/e-ui/ && cp -rf ../e-ui/static/css/e-ui.css browser-app/web-app/static/css/e-ui.css",

    "dev-tools:ehtml:update": "rsync -a --delete ../EHTML/src/ dev-tools/web-app/static/js/ehtml/",
    "dev-tools:nodes:update": "rsync -a --delete ../nodes.js/nodes/ dev-tools/nodes/",
    "dev-tools:eui:update": "rsync -a --delete ../e-ui/static/js/e-ui/ dev-tools/web-app/static/js/e-ui/ && cp -rf ../e-ui/static/css/e-ui.css dev-tools/web-app/static/css/e-ui.css",
    "dev-tools:vendor": "npm run dev-tools:nodes:update && npm run dev-tools:ehtml:update && npm run dev-tools:eui:update",
    "dev-tools:download": "node scripts/download-dev-tools-libraries.js",
    "dev-tools:setup": "npm run dev-tools:download && npm run setup:symlinks && npm run msq:apps:update && npm run web-components:update",
    "dev-tools": "node dev-tools/web-app/main.js",

    "docs:ehtml:update": "rsync -a --delete ../EHTML/src/ docs/web-app/static/js/ehtml/",
    "docs:nodes:update": "rsync -a --delete ../nodes.js/nodes/ docs/nodes/ && find docs/nodes -name '*.js' -exec perl -pi -e 's|#nodes/|#docs-nodes/|g' {} +",
    "docs:eui:update": "rsync -a --delete ../e-ui/static/js/e-ui/ docs/web-app/static/js/e-ui/ && cp -rf ../e-ui/static/css/e-ui.css docs/web-app/static/css/e-ui.css",
    "docs:e-dev:update": "rsync -a --delete ../e-pages/web-app/static/js/e-dev/ docs/web-app/static/js/e-dev/ && rsync -a --delete ../e-pages/web-app/api/e-dev/ docs/web-app/api/e-dev/ && find docs/web-app/api/e-dev -name '*.js' -exec perl -pi -e 's|#nodes/|#docs-nodes/|g' {} +",
    "docs:vendor": "npm run docs:nodes:update && npm run docs:ehtml:update && npm run docs:eui:update && npm run docs:e-dev:update",
    "docs:check": "node scripts/check-docs-examples.js",
    "docs:art": "node scripts/generate-landing-art.js",
    "docs:pipeline": "node scripts/generate-landing-pipeline.js",
    "docs:api-example": "node scripts/generate-api-example.js",
    "docs": "npm run setup:symlinks && npm run msq:apps:update && npm run web-components:update && npm run docs:check && node docs/web-app/main.js",

    "browser-app:setup": "npm run setup:symlinks && npm run msq:apps:update && npm run web-components:update",
    "browser-app": "node browser-app/web-app/main.js",
    "cli-app": "node cli-app/msq.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guseyn/MuSemantiQ.git"
  },
  "author": "guseyn",
  "license": "Credited Source License (CSL) v1.0",
  "bugs": {
    "url": "https://github.com/Guseyn/MuSemantiQ/issues"
  },
  "homepage": "https://github.com/Guseyn/MuSemantiQ#readme",
  "imports": {
    "#msq/drawer/*": "./src/drawer/*",
    "#msq/language/*": "./src/language/*",
    "#msq/midi/*": "./src/midi/*",
    "#msq/api.js": "./src/api.js",

    "#tools/*": "./tools/*",

    "#nodes/*": "./browser-app/nodes/*",
    "#dev-nodes/*": "./dev-tools/nodes/*",
    "#docs-nodes/*": "./docs/nodes/*"
  },
  "browser.importmap": {
    "#ehtml/": "/js/ehtml/",
    "#e-ui/": "/js/e-ui/",
    "#msq/web-components/": "/js/msq/web-components/",
    "#msq/language/": "/js/msq/language/",
    "#docs/": "/js/docs/",
    "#mermaid": "/js/docs/lib/mermaid/mermaid.esm.mjs"
  },
  "worker.importmap": {
    "#msq": "/js/msq/worker"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
