{
  "all": true,
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "src/drawer/lib",
    "src/language/lib",
    "src/midi/lib",
    "src/language/parser/scenarios/string/*",
    "src/drawer/generateUnicodePoints.js",
    "src/drawer/font-urls.js",

    "src/drawer/font/**",

    "src/worker.js",
    "src/utils.js",
    "src/midi/convertUint8ToBase64.js",

    "src/drawer/elements/basic/convertSvgToAnimatedString.js",
    "src/language/schema/**"
  ],
  "reporter": [
    "text",
    "html"
  ],
  "temp-dir": "./.nyc_output"
}
